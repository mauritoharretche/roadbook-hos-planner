# Backend: use these in your host dashboard or export them before starting Django.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
ROUTING_PROVIDER=mock
# For real routing in production:
# ROUTING_PROVIDER=ors
# ORS_API_KEY=

# Frontend: set this in Vercel for the deployed backend API.
VITE_API_BASE_URL=/api/v1
